# Supabase — copy this file to `.env.local` and fill in your values.
# Never commit the real values to version control.

# Example: https://abcdefghijklm.supabase.co
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6...
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: absolute URL used for password-reset links and email redirects
# when the request origin can't be inferred (e.g. in preview environments).
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI assistant & RAG (server-side only — never expose these to the browser)
# ---------------------------------------------------------------------------

# OpenRouter key for chat completions (the grounded answer generator).
# (https://openrouter.ai → Keys)
OPENROUTER_API_KEY=

# Service-role key (Project Settings → API → service_role). REQUIRED for the
# ingestion script, document reprocessing and admin deletions. Keep secret —
# never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter chat model. Defaults to openai/gpt-4o-mini.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Embedding provider: "openrouter" (default) or "openai". Both use the
# OpenAI-compatible /embeddings HTTP endpoint.
EMBEDDING_PROVIDER=openrouter

# Embedding API key. For provider "openrouter" this falls back to
# OPENROUTER_API_KEY when unset. For provider "openai" it is required.
# EMBEDDING_API_KEY=

# Embedding model. Defaults to text-embedding-3-small (1536 dimensions).
# If you change the model, also update EMBEDDING_DIMENSIONS and the
# legal_chunks.embedding vector(n) column in supabase/migrations, then
# re-ingest all documents.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional: alternative OpenAI-compatible embeddings base URL.
# EMBEDDING_BASE_URL=

# RAG retrieval knobs (optional, defaults shown).
# LEGALEASE_MAX_RETRIEVED_CHUNKS=8
# LEGALEASE_SIMILARITY_THRESHOLD=0.35
# LEGALEASE_MAX_CONTEXT_CHUNKS=6
# LEGALEASE_MAX_HISTORY_MESSAGES=8

# Chat rate limit (messages per minute per user).
# LEGALEASE_CHAT_RATE_LIMIT=10