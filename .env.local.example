# Supabase — copy this file to `.env.local` to configure authentication.
# Never commit the real values to version control.

# Your Supabase project URL, e.g. https://abcdefghijklm.supabase.co
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Your public anon key, e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6...
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your service-role key (Project Settings → API → service_role).
# REQUIRED for ingestion scripts, admin reprocessing and deletes.
# Keep secret — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: absolute URL used for password-reset links and email redirects
# when the request origin can't be inferred (e.g. in preview environments).
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI assistant & RAG (server-side only — never expose these to the browser)
# ---------------------------------------------------------------------------

# OpenRouter key for chat completions.
# (https://openrouter.ai → Keys)
OPENROUTER_API_KEY=

# OpenRouter chat model. Defaults to openai/gpt-4o-mini.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Embedding provider: "openrouter" (default) or "openai".
EMBEDDING_PROVIDER=openrouter

# Embedding API key. For "openrouter" this falls back to OPENROUTER_API_KEY.
# For "openai" it is required.
# EMBEDDING_API_KEY=

# Embedding model + dimensions. Defaults to text-embedding-3-small / 1536.
# Changing the model requires updating EMBEDDING_DIMENSIONS and the
# legal_chunks.embedding vector(n) column, then re-ingesting.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Optional: alternative OpenAI-compatible embeddings base URL.
# EMBEDDING_BASE_URL=

# RAG retrieval knobs (optional, defaults shown).
# LEGALEASE_MAX_RETRIEVED_CHUNKS=8
# LEGALEASE_SIMILARITY_THRESHOLD=0.35
# LEGALEASE_MAX_CONTEXT_CHUNKS=6
# LEGALEASE_MAX_HISTORY_MESSAGES=8

# Chat rate limit (messages per minute per user).
# LEGALEASE_CHAT_RATE_LIMIT=10